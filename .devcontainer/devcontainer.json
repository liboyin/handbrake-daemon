{
    "dockerComposeFile": "../docker-compose.dev.yaml",
    "service": "app",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:latest":{
            "configureZshAsDefaultShell": "true"
        }
    },
    "overrideCommand": true,
    "postCreateCommand": "chmod +x .devcontainer/postCreateCommand.sh && ./.devcontainer/postCreateCommand.sh",
    "remoteUser": "ubuntu",
    "workspaceFolder": "/workspaces/handbrake-daemon",
    "mounts": [
        // share Git + SSH config between host and container
        "source=${localEnv:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,readonly",
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
        // override .dockerignore to mount the entire workspace
        "source=${localWorkspaceFolder},target=/workspaces/handbrake-daemon,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "github.vscode-github-actions",
                "mhutchie.git-graph",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.live-server",
                "openai.chatgpt",
                "ryu1kn.partial-diff",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "yzhang.markdown-all-in-one"
            ]
        }
    }
}
